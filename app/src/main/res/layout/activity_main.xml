<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_soft_screen"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_palette_full"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="220dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="28dp"
            android:paddingRight="22dp"
            android:paddingBottom="42dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="4dp"
                android:paddingTop="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_login_panel"
                        android:gravity="center"
                        android:text="VI"
                        android:textColor="@color/validin_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_dark_chip"
                        android:gravity="center"
                        android:text="Campus Document Trust"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="ValidIn"
                    android:textColor="@color/white"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dokumen kampus, AI OCR, dan registry digital dalam satu aplikasi."
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_yellow_chip"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="AI + Blockchain Verification"
                    android:textColor="@color/validin_primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_glass_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Masuk"
                    android:textColor="@color/validin_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pilih role sebelum melanjutkan."
                    android:textColor="@color/validin_muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/roleStudentButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginRight="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:backgroundTint="@color/validin_primary"
                        android:text="Mahasiswa"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/roleAdminButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginLeft="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:backgroundTint="@color/validin_border"
                        android:text="Admin"
                        android:textAllCaps="false"
                        android:textColor="@color/validin_text"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="NIM"
                    android:textColor="@color/validin_muted"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/loginIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_input_modern"
                    android:hint="231011402890"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/validin_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Password"
                    android:textColor="@color/validin_muted"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/loginPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input_modern"
                    android:hint="Rahmat123"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/validin_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/loginErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/validin_danger"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_login_yellow_button"
                    android:backgroundTint="@color/validin_yellow"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="@color/validin_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_dark_chip"
                    android:gravity="center"
                    android:text="Private\nFingerprint"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_dark_chip"
                    android:gravity="center"
                    android:text="Campus\nRegistry"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/appContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_soft_screen"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="VI"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mainTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore"
                    android:textColor="@color/validin_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mainSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ValidIn Campus Trust"
                    android:textColor="@color/validin_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/userBadgeText"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_chip"
                android:gravity="center"
                android:text="RZ"
                android:textColor="@color/validin_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/homePage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_search_pill"
                        android:elevation="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="20dp"
                        android:paddingRight="12dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="⌕"
                            android:textColor="@color/validin_text"
                            android:textSize="32sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeGreetingText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Halo, Rahmat"
                                android:textColor="@color/validin_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verifikasi dokumen resmi kampus"
                                android:textColor="@color/validin_muted"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_modern_chip"
                            android:gravity="center"
                            android:text="☰"
                            android:textColor="@color/validin_primary"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="116dp"
                                android:layout_height="76dp"
                                android:background="@drawable/bg_yellow_chip"
                                android:gravity="center"
                                android:text="Sertifikat"
                                android:textColor="@color/validin_text"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="116dp"
                                android:layout_height="76dp"
                                android:layout_marginLeft="12dp"
                                android:background="@drawable/bg_modern_chip"
                                android:gravity="center"
                                android:text="Surat"
                                android:textColor="@color/validin_muted"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="116dp"
                                android:layout_height="76dp"
                                android:layout_marginLeft="12dp"
                                android:background="@drawable/bg_modern_chip"
                                android:gravity="center"
                                android:text="Logbook"
                                android:textColor="@color/validin_muted"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="116dp"
                                android:layout_height="76dp"
                                android:layout_marginLeft="12dp"
                                android:background="@drawable/bg_modern_chip"
                                android:gravity="center"
                                android:text="Transkrip"
                                android:textColor="@color/validin_muted"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="330dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_palette_hero"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ValidIn Registry"
                            android:textColor="@color/white"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Cari tahu apakah dokumen yang kamu terima benar-benar diterbitkan oleh issuer kampus."
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/homeLastStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="24dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_login_panel"
                            android:gravity="center_vertical"
                            android:padding="18dp"
                            android:text="Belum ada dokumen yang diverifikasi."
                            android:textColor="@color/validin_text"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/quickVerifyButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_yellow"
                            android:text="Mulai verifikasi"
                            android:textAllCaps="false"
                            android:textColor="@color/validin_primary_dark"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="124dp"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/statVerifiedText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_modern_card"
                            android:gravity="center"
                            android:text="0\nValid"
                            android:textColor="@color/validin_success"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/statReviewText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_modern_card"
                            android:gravity="center"
                            android:text="0\nReview"
                            android:textColor="@color/validin_warning"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/verifyPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verify"
                        android:textColor="@color/validin_text"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_palette_hero"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_login_panel"
                            android:gravity="center"
                            android:text="AI"
                            android:textColor="@color/validin_primary"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Upload atau scan dokumen"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/pickDocumentButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_yellow"
                            android:text="Pilih dokumen"
                            android:textAllCaps="false"
                            android:textColor="@color/validin_primary_dark"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/scanDocumentButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_accent"
                            android:text="Scan dengan kamera"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/fileNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Belum ada file dipilih"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/hashText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Fingerprint: -"
                            android:textColor="@color/white"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_modern_card"
                        android:elevation="3dp"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AI Inspector"
                            android:textColor="@color/validin_text"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/aiStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="AI akan membaca nama, nomor induk, tanggal, dan penerbit dokumen."
                            android:textColor="@color/validin_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/extractedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/validin_text"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/verifyButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_primary"
                            android:enabled="false"
                            android:text="Cek status"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/resultText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Hasil pemeriksaan akan muncul di sini."
                            android:textColor="@color/validin_text"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/adminPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Issuer Studio"
                        android:textColor="@color/validin_text"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_modern_card"
                        android:elevation="3dp"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Terbitkan dokumen"
                            android:textColor="@color/validin_text"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Upload atau scan dokumen resmi. Fingerprint akan dikirim ke admin server."
                            android:textColor="@color/validin_muted"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/pickAdminDocumentButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_primary"
                            android:text="Pilih dokumen admin"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/scanAdminDocumentButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_accent"
                            android:text="Scan dokumen admin"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/adminFileNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Belum ada dokumen admin."
                            android:textColor="@color/validin_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/adminHashText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Fingerprint: -"
                            android:textColor="@color/validin_text"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/adminDocTypeInput"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_input_modern"
                            android:hint="Jenis dokumen"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/validin_text" />

                        <EditText
                            android:id="@+id/adminSubjectInput"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input_modern"
                            android:hint="Pemilik dokumen"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/validin_text" />

                        <ProgressBar
                            android:id="@+id/adminProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/registerAdminButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_primary_button"
                            android:backgroundTint="@color/validin_yellow"
                            android:enabled="false"
                            android:text="Daftarkan dokumen"
                            android:textAllCaps="false"
                            android:textColor="@color/validin_primary_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/adminResultText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Dokumen baru akan aktif setelah transaksi registry berhasil."
                            android:textColor="@color/validin_text"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/historyPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/validin_text"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/historyListText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_modern_card"
                        android:elevation="3dp"
                        android:padding="22dp"
                        android:text="Belum ada riwayat."
                        android:textColor="@color/validin_text"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/profilePage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textColor="@color/validin_text"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp">

                            <TextView
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:background="@drawable/bg_avatar_circle"
                                android:gravity="center"
                                android:text="RZ"
                                android:textColor="@color/white"
                                android:textSize="38sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="78dp"
                                android:layout_height="38dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_yellow_chip"
                                android:gravity="center"
                                android:text="100%"
                                android:textColor="@color/validin_primary_dark"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/profileNameText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Rahmat Zeka"
                                android:textColor="@color/validin_text"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/profileIdText"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_modern_chip"
                                android:gravity="center_vertical"
                                android:paddingLeft="14dp"
                                android:paddingRight="14dp"
                                android:text="Mahasiswa"
                                android:textColor="@color/validin_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/registryStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_modern_card"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="22dp"
                        android:paddingRight="22dp"
                        android:text="Registry kampus aktif dan siap digunakan"
                        android:textColor="@color/validin_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="116dp"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_modern_card"
                            android:gravity="center"
                            android:text="AI\nReady"
                            android:textColor="@color/validin_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_modern_card"
                            android:gravity="center"
                            android:text="Trust\nRegistry"
                            android:textColor="@color/validin_accent"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_primary_button"
                        android:backgroundTint="@color/validin_primary"
                        android:text="Keluar"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_bottom_nav"
            app:itemIconTint="@color/bottom_nav_item"
            app:itemTextColor="@color/bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</FrameLayout>
